<view class="page">
  <view class="card">
    <view class="title">注册设备</view>
    <view class="field">
      <text class="label">设备 ID *</text>
      <input class="input" placeholder="如 ss928-001" value="{{deviceId}}"
             data-field="deviceId" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">名称</text>
      <input class="input" placeholder="如 大棚一号" value="{{name}}"
             data-field="name" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">位置</text>
      <input class="input" placeholder="如 1 号温室" value="{{location}}"
             data-field="location" bindinput="onInput" />
    </view>
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <button class="submit" type="primary" disabled="{{submitting}}"
            bindtap="onSubmit">{{submitting ? '提交中…' : '注册'}}</button>
  </view>
</view>
