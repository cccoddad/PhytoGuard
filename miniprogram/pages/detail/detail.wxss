.loading {
  padding: 96rpx 0;
  color: #7a897e;
  text-align: center;
}

.image-box,
.image-empty {
  position: relative;
  margin-bottom: 20rpx;
  background: #ffffff;
  border: 1rpx solid #dfe8e1;
  border-radius: 14rpx;
  box-shadow: 0 12rpx 30rpx rgba(39, 75, 49, 0.08);
  overflow: hidden;
}

.alert-image {
  display: block;
  width: 100%;
  height: 500rpx;
  background: #17251b;
}

.image-hint {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  padding: 8rpx 16rpx;
  background: rgba(23, 37, 27, 0.72);
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 23rpx;
}

.image-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 300rpx;
  color: #7a897e;
  font-size: 26rpx;
}

.image-empty-icon {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 14rpx;
  background: #fff0d8;
  color: #a95b11;
  border-radius: 50%;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 54rpx;
  text-align: center;
}

.info-card,
.detail-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #dfe8e1;
  border-radius: 14rpx;
  box-shadow: 0 10rpx 24rpx rgba(31, 58, 39, 0.07);
}

.status-pill {
  display: inline-block;
  margin-bottom: 18rpx;
  padding: 7rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.status-pill.new {
  background: #e5f3e9;
  color: #2f6f44;
}

.status-pill.done {
  background: #eef2ef;
  color: #7a897e;
}

.disease-title {
  color: #17251b;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
}

.disease-sub {
  margin-top: 12rpx;
  color: #6f7f73;
  font-size: 25rpx;
  line-height: 1.45;
}

.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  flex: 1;
  min-width: 0;
  padding: 22rpx 12rpx;
  background: #ffffff;
  border: 1rpx solid #dfe8e1;
  border-radius: 14rpx;
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(31, 58, 39, 0.06);
}

.stat-value {
  display: block;
  color: #2f6f44;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.2;
}

.stat-value.severity-severe {
  color: #b92f2f;
}

.stat-value.severity-warning {
  color: #a95b11;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  color: #7a897e;
  font-size: 21rpx;
  line-height: 1.3;
}

.card-title {
  padding-bottom: 18rpx;
  color: #17251b;
  font-size: 30rpx;
  font-weight: 750;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 26rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #eef2ef;
}

.detail-key {
  flex-shrink: 0;
  color: #7a897e;
  font-size: 26rpx;
}

.detail-val {
  min-width: 0;
  color: #253428;
  font-size: 26rpx;
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.btn-row {
  padding-bottom: 26rpx;
}

.ack-btn {
  width: 100%;
  height: 88rpx;
  background: #2f6f44;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.ack-btn::after {
  border: none;
}
